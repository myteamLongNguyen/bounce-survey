{
  "title": "Operational Resilience in Schools Benchmarking Initiative",
  "subtitle": "ABSA x Bounce Research Project Australia and New Zealand | 2026",
  "intro": [
    {
      "title": "Purpose of this survey",
      "body": "ABSA and Bounce have partnered together on this research project to better understand operational resilience preparedness across schools in Australia and New Zealand. This research will establish a baseline understanding of resilience capability across schools and providing evidence-based insights that support improved preparedness, governance, decision-making, and operational continuity. Specifically, the data produced from this initiative will allow us to gain member intelligence and benchmarking. The findings will be used to identify sector trends, benchmark preparedness, and develop practical resources and tools for schools."
    },
    {
      "title": "Who should complete this survey?",
      "body": "This survey is intended for school leaders and personnel responsible for operational resilience, including principals, deputy principals, business managers, operations managers, risk/compliance personnel, wellbeing leaders, and emergency management or critical incident team members."
    },
    {
      "title": "Time to complete",
      "body": "Approximately 15-20 minutes."
    },
    {
      "title": "Privacy",
      "body": "ASBA and Bounce will use the information provided to administer the survey, prepare your school's benchmarking report, provide relevant updates and develop aggregated sector insights. Identifiable results will not be publicly attributed to your school without separate permission. Participation is voluntary, and you should not include personal or sensitive information about students, staff or incident victims."
    }
  ],
  "formNote": "When you submit this form, it will not automatically collect your details like name and email address unless you provide it yourself.",
